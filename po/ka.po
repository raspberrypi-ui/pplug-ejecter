#: src/ejecter.c:67
msgid "Hide icon when no devices"
msgstr "ხატულას დამალვა მოწყობილობების არარსებობისას"

#: src/ejecter.c:68
msgid "Automount removable devices"
msgstr "მოხსნადი მოწყობილობების ავტომიმაგრება"

#: src/ejecter.c:225
#, c-format
msgid "Removable drive %s connected"
msgstr "მოხსნადი დისკი %s დაკავშირებულია"

#: src/ejecter.c:229
msgid "Open"
msgstr "გახსნა"

#: src/ejecter.c:297
msgid ""
"Drive was removed without ejecting\n"
"Please use menu to eject before removal"
msgstr ""
"დისკი მოხსნილია ამოღების გარეშე\n"
"ამოღებამდე გამოიყენეთ ამოღების მენიუ"

#: src/ejecter.c:381 src/ejecter.c:439
#, c-format
msgid ""
"%s has been ejected\n"
"It is now safe to remove the device"
msgstr ""
"%s მოხსნილია\n"
"ახლა მოწყობილობის მოხსნა უსაფრთხოა"

#: src/ejecter.c:387 src/ejecter.c:446
#, c-format
msgid ""
"Failed to eject %s\n"
"%s"
msgstr ""
"%s-ის მოხსნის შეცდომა\n"
"%s"

#: src/ejecter.c:410
#, c-format
msgid ""
"%s has been stopped\n"
"It is now safe to remove the device"
msgstr ""
"%s გაჩერებულია\n"
"ახლა მოწყობილობის მოხსნა უსაფრთხოა"

#: src/ejecter.c:415
#, c-format
msgid ""
"Failed to stop %s\n"
"%s"
msgstr ""
"%s-ის გაჩერება ჩავარდა\n"
"%s"

#: src/ejecter.c:471
#, c-format
msgid ""
"%s has been unmounted\n"
"It is now safe to remove the device"
msgstr ""
"%s მიმაგრება გაუქმდა\n"
"ახლა მოწყობილობის მოხსნა უსაფრთხოა"

#: src/ejecter.c:478
#, c-format
msgid ""
"Failed to unmount %s\n"
"%s"
msgstr ""
"%s-ის მიმაგრების გაუქმება ჩავარდა\n"
"%s"

#: src/ejecter.c:678
msgid "Select a drive in menu to eject safely"
msgstr "აირჩიეთ მენიუში დისკი უსაფრთხოდ ამოსაღებად"

#: src/ejecter.c:815
msgid "Ejects mounted drives"
msgstr "ამოიღებს მიმაგრებულ დისკებს"

